NODE_ENV=development
PORT=8080
CLIENT_ORIGIN=http://localhost:5173
CORS_EXTRA_ORIGINS=

JWT_SECRET=replace-with-64-plus-character-random-secret
SESSION_TTL=7d
ENABLE_AUTH_COOKIES=false
REALTIME_TICKET_FAST_AUTH=true
REALTIME_TICKET_FAST_AUTH_MAX_AGE_MS=1800000
MONITORING_SECRET=replace-with-random-monitoring-token

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_ESCAPED_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
# In production, App Check is enforced unless this is explicitly set to false.
ENFORCE_APP_CHECK=false
FIREBASE_ACTION_CONTINUE_URL=http://localhost:5173/dealer/login

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-strong-one-time-password

RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
AUTH_LOOKUP_RATE_LIMIT_MAX=60
LOGIN_FAILURE_RATE_LIMIT_MAX=60
PASSWORD_RESET_RATE_LIMIT_MAX=5
REGISTRATION_RATE_LIMIT_MAX=15
PUBLIC_LEAD_RATE_LIMIT_MAX=8
UPLOAD_RATE_LIMIT_MAX=30

DISABLE_SLA_ENGINE=false
SLA_ENGINE_INTERVAL_MS=60000
DISABLE_WHATSAPP_QUEUE=true
WHATSAPP_QUEUE_INTERVAL_MS=30000
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional enterprise scale services
REDIS_URL=
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_MS=60000
QUEUE_COMPLETE_TTL_SECONDS=86400
QUEUE_FAILED_TTL_SECONDS=604800

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0
ALERT_SLOW_API_MS=2000
ALERT_CRITICAL_API_MS=5000
ALERT_QUEUE_FAILED_JOBS=10
ALERT_QUEUE_BACKLOG_JOBS=250
ALERT_MEMORY_RSS_MB=450
ALERT_DEDUPE_WINDOW_MS=300000
ALERT_EMAIL_TO=
SLACK_WEBHOOK_URL=
ALERT_WHATSAPP_TO=
ALERT_SMS_TO=
FIRESTORE_MAX_PAGE_SIZE=100
FIRESTORE_QUERY_TIMEOUT_MS=8000
FIRESTORE_SLOW_QUERY_MS=1200
SLA_ENGINE_BATCH_SIZE=100

LEAD_ARCHIVE_AFTER_DAYS=180
ARCHIVAL_BATCH_SIZE=50
ARCHIVE_DELETE_SOURCE=false
NOTIFICATION_TTL_DAYS=90

ENABLE_SCHEDULED_OPERATIONS=false
NOTIFICATION_CLEANUP_INTERVAL_MS=21600000
ARCHIVAL_INTERVAL_MS=86400000
METRICS_INTEGRITY_INTERVAL_MS=3600000
BACKFILL_APPLY=false
BACKFILL_BATCH_SIZE=250

# Staging-only load testing
LOAD_TEST_ENV=staging
LOAD_TEST_SEED_APPLY=false
LOAD_TEST_LEAD_COUNT=1000
LOAD_TEST_BATCH_SIZE=250
LOAD_TEST_DEALERSHIPS=10
LOAD_TEST_BANKS=5
LOAD_TEST_EXECUTIVES=20
