rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : null;
    }

    function email() {
      return signedIn() ? request.auth.token.email : null;
    }

    function dealershipId() {
      return signedIn() ? request.auth.token.dealershipId : null;
    }

    function bankId() {
      return signedIn() ? request.auth.token.bankId : null;
    }

    function branchId() {
      return signedIn() ? request.auth.token.branchId : null;
    }

    function isSuperAdmin() {
      return role() == "super-admin";
    }

    function isFinanceDesk() {
      return role() == "finance-desk";
    }

    function isGmSm() {
      return role() == "gm-sm";
    }

    function isBankManager() {
      return role() == "bank-manager";
    }

    function isLoanExecutive() {
      return role() == "loan-executive";
    }

    function approved() {
      return signedIn()
        && request.auth.token.approved == true
        && request.auth.token.active == true;
    }

    function sameDealership(data) {
      return approved()
        && dealershipId() != null
        && data.dealershipId == dealershipId();
    }

    function sameBank(data) {
      return approved()
        && bankId() != null
        && data.bankId == bankId();
    }

    function sameBranch(data) {
      return approved()
        && branchId() != null
        && (
          data.branchId == branchId()
        || data.bankBranchCity == branchId()
        || data.branchCity == branchId()
        || data.routingCity == branchId()
          || data.city == branchId()
        );
    }

    function assignedExecutive(data) {
      return approved()
        && (
          data.assignedExecutiveId == request.auth.uid
          || data.assignedExecutiveId == email()
          || data.assignedExecutiveEmail == email()
        );
    }

    function canReadLead(data) {
      return isSuperAdmin()
        || ((isFinanceDesk() || isGmSm()) && sameDealership(data))
        || (isBankManager() && sameBank(data) && sameBranch(data))
        || (isLoanExecutive() && assignedExecutive(data));
    }

    function canReadDocument(data) {
      return isSuperAdmin()
        || sameDealership(data)
        || (sameBank(data) && sameBranch(data))
        || assignedExecutive(data);
    }

    function canReadTimeline(data) {
      return canReadLead(data)
        || (
          data.leadId != null
          && exists(/databases/$(database)/documents/leads/$(data.leadId))
          && canReadLead(get(/databases/$(database)/documents/leads/$(data.leadId)).data)
        );
    }

    function canReadNotification(data) {
      return isSuperAdmin()
        || (approved() && data.userId == request.auth.uid)
        || (approved() && data.recipientId == email())
        || ((isFinanceDesk() || isGmSm()) && data.dealershipId == dealershipId())
        || (isBankManager() && data.bankId == bankId() && sameBranch(data))
        || (isLoanExecutive()
          && (
            data.assignedExecutiveId == request.auth.uid
            || data.assignedExecutiveId == email()
            || data.assignedExecutiveEmail == email()
            || data.recipientId == email()
          ));
    }

    function canReadPortalProjection(data) {
      return isSuperAdmin()
        || ((isFinanceDesk() || isGmSm())
          && data.scopeType == "dealership"
          && dealershipId() != null
          && data.scopeId == dealershipId())
        || (isBankManager()
          && data.scopeType == "bank"
          && bankId() != null
          && data.scopeId == bankId())
        || (isLoanExecutive()
          && data.scopeType == "executive"
          && (
            data.scopeId == request.auth.uid
            || data.scopeId == email()
            || data.assignedExecutiveId == request.auth.uid
            || data.assignedExecutiveId == email()
            || data.assignedExecutiveEmail == email()
          ));
    }

    function safeNotificationReadUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt", "updatedAt"]);
    }

    function immutableUserSecurityFields() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.approved == resource.data.approved
        && request.resource.data.active == resource.data.active
        && request.resource.data.accountApproved == resource.data.accountApproved
        && request.resource.data.accountActive == resource.data.accountActive
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.dealershipId == resource.data.dealershipId
        && request.resource.data.bankId == resource.data.bankId;
    }

    function ownDealerRegistration(data) {
      return signedIn()
        && data.dealerUid == request.auth.uid
        && data.email == email();
    }

    function pendingDealerAccountWrite(data, accountId) {
      return signedIn()
        && accountId == request.auth.uid
        && data.uid == request.auth.uid
        && data.email == email()
        && data.accountApproved == false
        && data.accountActive == false
        && data.registrationCompleted == true
        && data.registrationSubmitted == true
        && data.approvalStatus == "pending";
    }

    match /users/{userId} {
      allow read: if approved()
        && (request.auth.uid == userId || email() == userId);
      allow update: if approved()
        && (request.auth.uid == userId || email() == userId)
        && immutableUserSecurityFields();
      allow create, delete: if false;
      allow read, write: if isSuperAdmin();
    }

    match /leads/{leadId} {
      allow read: if canReadLead(resource.data);
      allow create: if isFinanceDesk()
        && approved()
        && request.resource.data.dealershipId == dealershipId();
      allow update: if isLoanExecutive()
        && assignedExecutive(resource.data)
        && request.resource.data.dealershipId == resource.data.dealershipId
        && request.resource.data.bankId == resource.data.bankId;
      allow delete: if false;
      allow read, write: if isSuperAdmin();
    }

    match /documents/{documentId} {
      allow read: if canReadDocument(resource.data);
      allow create: if isFinanceDesk()
        && approved()
        && request.resource.data.dealershipId == dealershipId()
        && request.resource.data.uploadedBy == email();
      allow update: if isLoanExecutive()
        && assignedExecutive(resource.data)
        && request.resource.data.leadId == resource.data.leadId
        && request.resource.data.dealershipId == resource.data.dealershipId
        && request.resource.data.bankId == resource.data.bankId
        && request.resource.data.assignedExecutiveId == resource.data.assignedExecutiveId
        && request.resource.data.assignedExecutiveEmail == resource.data.assignedExecutiveEmail;
      allow delete: if false;
      allow read, write: if isSuperAdmin();
    }

    match /leadTimeline/{timelineId} {
      allow read: if canReadTimeline(resource.data);
      allow create, update, delete: if false;
      allow read, write: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if canReadNotification(resource.data);
      allow update: if canReadNotification(resource.data) && safeNotificationReadUpdate();
      allow create, delete: if false;
      allow read, write: if isSuperAdmin();
    }

    match /adminViews/{viewId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /financeViews/{viewId} {
      allow read: if isSuperAdmin()
        || (isFinanceDesk() && canReadPortalProjection(resource.data));
      allow write: if false;
    }

    match /gmViews/{viewId} {
      allow read: if isSuperAdmin()
        || (isGmSm() && canReadPortalProjection(resource.data));
      allow write: if false;
    }

    match /bankViews/{viewId} {
      allow read: if isSuperAdmin()
        || (isBankManager() && canReadPortalProjection(resource.data));
      allow write: if false;
    }

    match /executiveViews/{viewId} {
      allow read: if isSuperAdmin()
        || (isLoanExecutive() && canReadPortalProjection(resource.data));
      allow write: if false;
    }

    match /bankDealershipViews/{viewId} {
      allow read: if isSuperAdmin()
        || (isBankManager()
          && approved()
          && resource.data.bankId == bankId());
      allow write: if false;
    }

    match /notificationLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /whatsappQueue/{queueId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /notificationEvents/{eventId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /authAuditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /documentAuditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /salespersons/{salespersonId} {
      allow read: if isSuperAdmin()
        || ((isFinanceDesk() || isGmSm()) && sameDealership(resource.data));
      allow create, update: if isFinanceDesk()
        && approved()
        && request.resource.data.dealershipId == dealershipId();
      allow delete: if false;
      allow read, write: if isSuperAdmin();
    }

    match /financeManagers/{managerId} {
      allow read: if isSuperAdmin()
        || ((isFinanceDesk() || isGmSm()) && sameDealership(resource.data));
      allow create, update: if isFinanceDesk()
        && approved()
        && request.resource.data.dealershipId == dealershipId();
      allow delete: if false;
      allow read, write: if isSuperAdmin();
    }

    match /loanExecutives/{executiveId} {
      allow read: if isSuperAdmin()
        || (isBankManager() && sameBank(resource.data) && sameBranch(resource.data))
        || (isLoanExecutive() && (request.auth.uid == executiveId || resource.data.email == email()));
      allow create, update, delete: if false;
      allow read, write: if isSuperAdmin();
    }

    match /bankPartners/{partnerId} {
      allow read: if isSuperAdmin()
        || (isBankManager() && sameBank(resource.data) && sameBranch(resource.data));
      allow create, update, delete: if false;
      allow read, write: if isSuperAdmin();
    }

    match /dealerships/{dealerId} {
      allow read: if isSuperAdmin()
        || ((isFinanceDesk() || isGmSm()) && sameDealership(resource.data));
      allow create, update, delete: if false;
      allow read, write: if isSuperAdmin();
    }

    match /dealershipBankTieUps/{tieUpId} {
      allow read: if isSuperAdmin()
        || ((isFinanceDesk() || isGmSm()) && sameDealership(resource.data));
      allow create, update, delete: if false;
      allow read, write: if isSuperAdmin();
    }

    match /approvedDealerships/{dealerId} {
      allow read: if isSuperAdmin()
        || ((isFinanceDesk() || isGmSm()) && sameDealership(resource.data));
      allow create, update, delete: if false;
      allow read, write: if isSuperAdmin();
    }

    match /dealerRegistrationDocuments/{documentId} {
      allow read: if isSuperAdmin()
        || (signedIn() && resource.data.dealerUid == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.dealerUid == request.auth.uid
        && request.resource.data.verified == false;
      allow delete: if false;
      allow read, write: if isSuperAdmin();
    }

    match /dealerRegistrations/{dealerId} {
      allow read: if isSuperAdmin()
        || (signedIn() && dealerId == request.auth.uid && resource.data.email == email());
      allow create, update: if ownDealerRegistration(request.resource.data)
        && dealerId == request.auth.uid
        && request.resource.data.registrationStatus == "pending-approval";
      allow delete: if false;
      allow read, write: if isSuperAdmin();
    }

    match /pendingDealerAccounts/{accountId} {
      allow read: if isSuperAdmin()
        || (signedIn() && accountId == request.auth.uid && resource.data.email == email());
      allow create, update: if pendingDealerAccountWrite(request.resource.data, accountId);
      allow delete: if false;
      allow read, write: if isSuperAdmin();
    }

    match /pendingDealershipApprovals/{id} {
      allow read, write: if isSuperAdmin();
    }

    match /pendingBankApprovals/{id} {
      allow read, write: if isSuperAdmin();
    }

    match /loginActivity/{id} {
      allow read, write: if isSuperAdmin();
    }

    match /systemCounters/{id} {
      allow read, write: if false;
    }

    match /metrics/{id} {
      allow read: if isSuperAdmin()
        || ((isFinanceDesk() || isGmSm()) && resource.data.scopeType == "dealership" && resource.data.scopeId == dealershipId())
        || (isBankManager() && resource.data.scopeType == "bank" && resource.data.scopeId == bankId())
        || (isLoanExecutive() && resource.data.scopeType == "executive" && resource.data.scopeId == request.auth.uid);
      allow write: if false;
    }

    match /dailyMetrics/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /monthlyMetrics/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /dealershipMetrics/{id} {
      allow read: if isSuperAdmin()
        || ((isFinanceDesk() || isGmSm()) && id == dealershipId());
      allow write: if false;
    }

    match /bankMetrics/{id} {
      allow read: if isSuperAdmin()
        || (isBankManager() && id == bankId());
      allow write: if false;
    }

    match /executiveMetrics/{id} {
      allow read: if isSuperAdmin()
        || (isLoanExecutive() && id == request.auth.uid);
      allow write: if false;
    }

    match /bankAnalyticsSummaries/{id} {
      allow read: if isSuperAdmin()
        || (isBankManager() && resource.data.bankId == bankId());
      allow write: if false;
    }

    match /bankExecutiveAnalytics/{id} {
      allow read: if isSuperAdmin()
        || (isBankManager() && resource.data.bankId == bankId())
        || (isLoanExecutive() && resource.data.executiveId == request.auth.uid);
      allow write: if false;
    }

    match /bankRecentCases/{id} {
      allow read: if isSuperAdmin()
        || (isBankManager() && resource.data.bankId == bankId())
        || (isLoanExecutive() && resource.data.executiveId == request.auth.uid);
      allow write: if false;
    }

    match /bankAnalyticsLeadStates/{id} {
      allow read, write: if false;
    }

    match /operationalMetrics/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /operationalEvents/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /operationalAlerts/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /archivedLeads/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /archivalLogs/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // NEW: Dynamic Bank Branch Management
    // Banks collection - Global bank branches with IFSC codes
    match /banks/{bankId} {
      // Read: Finance desk can see approved/active banks; super admin can see all
      allow read: if isSuperAdmin()
        || (isFinanceDesk() && approved() && resource.data.approved == true && resource.data.active == true)
        || (isBankManager() && approved() && resource.data.id == bankId());
      
      // Write: Super admin only
      allow create, update, delete: if isSuperAdmin();
      allow read, write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
