# Development: http://localhost:8080/api
# Staging/production: set to the deployed backend API origin, ending in /api.
VITE_API_BASE_URL=http://localhost:8080/api
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_ACTION_CONTINUE_URL=http://localhost:5173/dealer-login
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Optional production monitoring
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_SAMPLE_RATE=0
VITE_SENTRY_REPLAY_ERROR_SAMPLE_RATE=0.1
VITE_APP_RELEASE=
VITE_APP_ENV=production
VITE_VERCEL_GIT_COMMIT_SHA=
